# Par defaut, laisser false pour travailler en donnees fictives locales.
VITE_USE_SUPABASE=false

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Variables locales reservees aux scripts d'administration Supabase.
# Ne jamais les ajouter dans Netlify et ne jamais les committer.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
LUCAS_PASSWORD=
AWEN_PASSWORD=
